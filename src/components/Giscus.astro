<section class="giscus mt-8" aria-label="Comments"></section>

<script is:inline data-astro-rerun>
  const GISCUS_ORIGIN = "https://giscus.app";
  const currentScript = document.currentScript;
  const container = currentScript?.previousElementSibling;

  function getGiscusTheme() {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function setGiscusTheme(theme) {
    const frame = document.querySelector("iframe.giscus-frame");
    frame?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme } } },
      GISCUS_ORIGIN
    );
  }

  if (container && !container.querySelector("script")) {
    const script = document.createElement("script");
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-repo", "vamsee/vamsee.in");
    script.setAttribute("data-repo-id", "R_kgDOUcCg5Q");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDOUcCg5c4DFzvl");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "bottom");
    script.setAttribute("data-theme", getGiscusTheme());
    script.setAttribute("data-lang", "en");
    container.appendChild(script);
  }

  if (!window.__giscusThemeSync) {
    window.addEventListener("theme:change", event => {
      const theme = event.detail?.theme === "dark" ? "dark" : "light";
      setGiscusTheme(theme);
    });
    window.__giscusThemeSync = true;
  }
</script>
